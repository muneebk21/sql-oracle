# Postgres (used by docker-compose.yml)
POSTGRES_DB=sql_oracle
POSTGRES_USER=sql_oracle
POSTGRES_PASSWORD=changeme

# Connection string used by the NestJS app
DATABASE_URL=postgresql://sql_oracle:changeme@localhost:5432/sql_oracle

# Groq API key (OpenAI-compatible endpoint) for NL -> SQL generation
GROQ_API_KEY=your_groq_api_key_here
